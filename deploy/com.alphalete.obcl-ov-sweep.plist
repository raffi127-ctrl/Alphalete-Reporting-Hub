<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.obcl-ov-sweep</string>

    <!-- Ticks Digi Docs / Onboarding Quizzes / UID Request / Owner Submit on
         the D2D OBCL tab off OwnerVille's View Progress, and paints Owner
         Submit blue when someone is ready to be submitted. SENDS NOTHING.
         Install: lucy rerun install_obcl_ov_sweep_agent machine "Lucy 3" -->

    <!-- Path is the laptop placeholder; install_agent.py rewrites it to the
         target machine's repo path. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/obcl_ov_sweep.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Hourly 2pm-7pm machine-local (Lucy 3 is Central), every day
         (Megan 2026-09-21). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/obcl-ov-sweep.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/obcl-ov-sweep.launchd.err.log</string>
</dict>
</plist>
