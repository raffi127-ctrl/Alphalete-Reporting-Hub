<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.new-start-followup-sat</string>

    <!-- Path is the laptop placeholder; on the mini, regenerate with the install
         path via the python-replace step in workflows/scheduler-mini.md. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/new_start_followup.sh</string>
        <string>--mode</string>
        <string>nudge</string>
        <string>--when</string>
        <string>morning</string>
        <string>--live</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Saturday only (Weekday 6), machine LOCAL time (mini is Central).
         ONE nudge at 1pm. Cut from three (10am/1pm/5pm) on 2026-07-26 — a
         straggler was getting @-tagged 5x a weekend (8am roll call + 3 nudges +
         Sun checklist) and Megan called it too many pings. Now: 8am roll call +
         this one 1pm nudge + Sun checklist = ~3 tags max.
         The run re-reads the thread and tags ONLY whoever still hasn't replied,
         so leaders who already sent don't get pinged.
         "--when morning" is the neutral "Reminder — if you haven't texted…"
         wording (not "Second reminder"/"Last call"), which fits a lone nudge.
         The 5pm -sat-pm plist was RETIRED in the same change (uninstall via
         `lucy rerun uninstall_new_start_nudge_pm_agent`); one interval here is
         under schedule_guard's 2-interval poller cutoff, so no split is needed. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>6</integer>
            <key>Hour</key><integer>13</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/new-start-followup-sat.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/new-start-followup-sat.launchd.err.log</string>
</dict>
</plist>
