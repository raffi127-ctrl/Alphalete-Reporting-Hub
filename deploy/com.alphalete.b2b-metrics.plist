<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.b2b-metrics</string>

    <!-- Path is the laptop placeholder; on the machine, install_agent.py rewrites
         it to that repo path (python -m automations.day_orchestrator.install_agent
         b2b-metrics). INSTALL ON LUCY 2 ONLY — Carlos's login is what makes the
         Activation view come down sorted. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/b2b_metrics.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- DAILY incl. weekends (no Weekday key). PRIMARY pass 7:45 CST, after
         vantura_churn's 7:00 run writes today's LUCY CHURN tab (items #4/#5
         screenshot it). Then a FRESHNESS LADDER for the two order-log sections
         (#8/#9), which depend on the ORDERLOG extract that can land late
         (esp. weekends): 8:45 and 9:45 retry in require-fresh mode (the
         wrapper adds that flag before 10:00, so a stale log is DEFERRED), and
         10:30 is the FLOOR (flag omitted, posts whatever the extract has, so
         the sections are never permanently absent). Mirrors box_order_log's
         7:00 require-fresh gate plus 8:30 floor. Retries are CHEAP: the runner
         skips re-capturing anything already in today's thread, so a later pass
         re-pulls only the still-missing sections. TIME KNOB: edit these entries
         (Hour/Minute are machine LOCAL time; Lucy 2 is Central). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-metrics.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-metrics.launchd.err.log</string>
</dict>
</plist>
