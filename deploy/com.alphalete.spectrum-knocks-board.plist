<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.alphalete.spectrum-knocks-board</string>
    <!-- PATHS ARE MEGAN'S LAPTOP and are rewritten at install time by
         `lucy rerun install_spectrum_knocks_board_agent` (LUCY 4) to the machine's repo root. -->
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>/Users/megan/1st Claude Folder/deploy/spectrum_knocks_board.sh</string><string>--tick</string><string>--send</string><string>--text</string></array>
    <key>WorkingDirectory</key><string>/Users/megan/1st Claude Folder</string>
    <key>EnvironmentVariables</key><dict><key>PYTHONPATH</key><string>/Users/megan/1st Claude Folder</string></dict>
    <!-- Every 5 min; board.py posts 2:00 PM / 5:15 PM / 9:00 PM CT once each, Mon-Sat. -->
    <key>StartInterval</key><integer>300</integer>
    <key>StandardOutPath</key><string>/tmp/com.alphalete.spectrum-knocks-board.out</string>
    <key>StandardErrorPath</key><string>/tmp/com.alphalete.spectrum-knocks-board.err</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
