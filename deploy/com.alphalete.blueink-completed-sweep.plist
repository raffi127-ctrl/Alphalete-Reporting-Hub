<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.blueink-completed-sweep</string>

    <!-- Ticks the "Blue Ink" checkbox for anyone whose packet has been SIGNED.
         SENDS NOTHING — sync-completed only reads Blue Ink's Completed list
         and writes checkboxes, so a bad fire costs a tick, never a packet.
         Install: lucy rerun install_blueink_sweep_agent (machine Lucy 2) -->

    <!-- Path is the laptop placeholder; install_agent.py rewrites it to the
         target machine's repo path. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/blueink_completed_sweep.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- 15 minutes BEFORE every OBCL <- OwnerVille sweep pass (Megan
         2026-09-22), so the Blue Ink column is up to date when that sweep
         reads the tab: 07:45 Tue-Fri, then 13:45-18:45 hourly every day,
         machine-local (Lucy 2 is Central). No Monday morning pass: Monday is
         start day, the 07:30 send is running then and syncs the ticks itself.
         launchd Weekday: 2=Tue 3=Wed 4=Thu 5=Fri. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/blueink-completed.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/blueink-completed.launchd.err.log</string>
</dict>
</plist>
