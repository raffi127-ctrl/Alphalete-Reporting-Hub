<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.slack-skool-email</string>

    <!-- NOT INSTALLED YET. Arm it only once Megan has approved the copy, both
         links are in slack-skool-creds.json on Lucy 1, and reception's Gmail
         token is on that machine. The wrapper sends for real the moment this
         loads, and there is no unsend.
             lucy rerun install_slack_skool_email_agent  (machine "Lucy 1")
         Note: no double hyphens anywhere in these comments on purpose. XML
         forbids them inside a comment, and plutil accepts what plistlib will
         not, so an unreadable plist shows up as a phantom Hub card instead of
         an error. See reference_plist_double_hyphen. -->

    <!-- Path is the laptop placeholder; on Lucy 1, install_agent.py rewrites
         it to that machine's repo path. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/slack_skool_email.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- 8:00am machine LOCAL time (Lucy 1 is Central), EVERY DAY. It fires 30
         min after Blue Ink at 7:30, so the packet this email mentions is
         already on its way when the email lands.

         It was Monday only, and that had to change with the send (Megan
         2026-11-18: the email goes two days before somebody starts). A Monday
         start's send day is the SATURDAY, and a Monday timer never reaches
         it, so the lead would have quietly done nothing and everybody would
         still have been mailed on the day itself.

         Daily is safe because the decision moved into the run: it mails only
         the people whose own day is within the lead, never somebody whose day
         has passed, and never anybody Gmail says already has theirs. On a day
         with nobody due it sends nothing and says so. No Weekday key at all,
         deliberately, so nothing has to be kept in step with the office week.

         Note: no double hyphens anywhere in these comments on purpose. XML
         forbids them inside a comment, and plutil accepts what plistlib will
         not, so an unreadable plist shows up as a phantom Hub card instead of
         an error. See reference_plist_double_hyphen. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/slack-skool-email.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/slack-skool-email.launchd.err.log</string>
</dict>
</plist>
