<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.override-bulletin-send-fri</string>

    <!-- Path is the laptop placeholder; on the mini, install_agent.py rewrites it
         to the mini's repo path (python -m automations.day_orchestrator.install_agent
         override-bulletin-send-fri). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/override_bulletin_send_fri.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- FRIDAYS only (Weekday 5). Passes 09:10-13:00 CST.

         THE LINK HAS TO BE UP BY 10:10 CST (Eve, 2026-08-21). That is why the
         first four passes are tight (09:10 / 09:30 / 09:50 / 10:05) and only
         then does it settle into the old q25m tail. It does NOT wait for the
         fill window to close any more: the post pass reads the leftmost week
         header and HOLDS (exit 0, nothing posted, no Drive upload) unless
         fill.week_is_filled says that column has real numbers, so an early pass
         over an unfilled tab is a silent no-op, never a blank/wrong-week link.
         The fill writes the column in ONE batch_update, so there is no
         half-filled column for an early pass to catch. The post is idempotent,
         so the later passes never repost what an early one already put up.

         Getting 10:10 also needs the FILL to have LANDED by ~10:05: a fill run
         takes ~25-30 min, so its 08:00/08:30/09:00 passes are the ones that buy
         the margin (see com.alphalete.override-bulletin-fri.plist). If the ORG
         Override Summary publishes late, both agents hold and the link lands
         late — that is the source, not the schedule.

         TIME KNOB: edit these entries (Hour/Minute are machine LOCAL time; the
         mini is Central). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>55</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/override-bulletin-send.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/override-bulletin-send.launchd.err.log</string>
</dict>
</plist>
