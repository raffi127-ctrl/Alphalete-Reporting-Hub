<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.vantura-week-roll-mon</string>

    <!-- Path is the laptop placeholder; on Lucy 2, install_agent.py rewrites it
         to that machine's repo path (lucy rerun install_vantura_week_roll_agent). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/vantura_week_roll_mon.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Monday 08:20am, machine LOCAL time (Lucy 2 is Central). launchd
         Weekday: 0/7=Sun, 1=Mon … 6=Sat.

         WHY 08:20 (moved earlier from 11:30 on 2026-09-14 at Carlos's request —
         he wants the new board up super early Monday). The roll is boxed in on
         BOTH sides:
           * NOT BEFORE 08:05 — Monday's sales_boards production post renders
             the week that just CLOSED and refuses (exit 75) if the gold cell
             has already moved. Its retry ladder is 05:10, 05:35, 06:00, 06:25,
             06:50, 07:15, 07:40, 08:05 — the last START is 08:05, so rolling
             before it can finish would silently drop Sunday's numbers for the
             closing week. 08:20 leaves that final attempt ~15 min to land.
           * BEFORE 08:30 — car-rides-cleanup then runs 08:30-11:15, nine passes
             over the Stations tab whose Q2 this rewrites.
         So 08:20 is the first safe minute of the 08:05-08:30 gap. Still well
         before vantura_slack_sales fills Monday at 16:00 (which holds all
         evening if the board is still on the old week).

         08:20 is a FIXED time racing the 08:05 post's tail. To go truly earlier
         (e.g. ~05:30) the roll would need to GATE on the production post's
         success instead of racing the clock — a code change, not just a time.

         No browser: this is pure Sheets API, so it does not contend for the
         shared Chrome profile the way the 7:00-7:20 jobs do. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/vantura-week-roll-mon.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/vantura-week-roll-mon.launchd.err.log</string>
</dict>
</plist>
