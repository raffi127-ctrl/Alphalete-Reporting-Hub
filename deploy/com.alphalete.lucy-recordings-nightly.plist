<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.lucy-recordings-nightly</string>

    <!-- LUCY 2nd round recordings sheet for Raf (Eve 2026-11-06). LUCY 1
         (the audit bot's files live there). Path is the laptop placeholder;
         install_agent.py rewrites it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/lucy_recordings_nightly.sh</string>
        <!-- Month-to-date summary to the whole org (Alphalete Org Owners distro, once a day).
             Raf 2026-11-11: "yes please lets send to everyone" -> was --email (Raf + Colten + Eve). -->
        <string>--email-org</string>
        <!-- Raf's group DM list (--yesterday-slack) OFF 2026-11-16 (Eve): the list now goes in
             the "Lucy Second Round Scorecards" thread below. The "who's your owner?" DMs to
             reps with no owner stay on. -->
        <string>--ask-owners</string>
        <!-- "Lucy Second Round Scorecards" thread in the owner's recruiting channel: list +
             one PDF per day this week + month picture (Raf 2026-11-16). Trial on Raf 11/16, every
             owner from 11/17 (Eve 2026-11-16). Owners with no channel in
             first_round_scorecards/office_post.CHANNELS are skipped (logged). -->
        <string>--owner-threads</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- 8:00 AM every day, machine LOCAL time (Lucy 1 is Central). Moved from
         11 PM (Eve 2026-11-06): the 7:07 AM 2nd-round-retention pass has
         re-read yesterday's late 2nd rounds by then, so the sheet (and Raf's
         email) has yesterday complete. The label keeps "nightly" so the
         installed agent is replaced, not duplicated. -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/lucy-recordings.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/lucy-recordings.launchd.err.log</string>
</dict>
</plist>
