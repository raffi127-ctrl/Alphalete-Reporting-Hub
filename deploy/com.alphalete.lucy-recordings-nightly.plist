<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.lucy-recordings-nightly</string>

    <!-- LUCY 2nd round recordings sheet for Raf (Eve 2026-11-06). LUCY 1
         (the audit bot's files live there). Path is the laptop placeholder;
         install_agent.py rewrites it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/lucy_recordings_nightly.sh</string>
        <!-- Mail Raf the month-to-date summary after the fill (Eve rolled it out 2026-11-06). -->
        <string>--email</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- 8:00 AM every day, machine LOCAL time (Lucy 1 is Central). Moved from
         11 PM (Eve 2026-11-06): the 7:07 AM 2nd-round-retention pass has
         re-read yesterday's late 2nd rounds by then, so the sheet (and Raf's
         email) has yesterday complete. The label keeps "nightly" so the
         installed agent is replaced, not duplicated. -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/lucy-recordings.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/lucy-recordings.launchd.err.log</string>
</dict>
</plist>
