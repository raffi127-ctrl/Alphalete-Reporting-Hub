<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.b2b-dispositions-final</string>

    <!-- The 6:30pm final: the last Today's Activity + Time Tracker shots (tagged
         "Final") AND the per-territory Dispositions. Path is the laptop
         placeholder; install_agent.py rewrites it on Lucy 2:
         python -m automations.day_orchestrator.install_agent b2b-dispositions-final -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/b2b_dispositions.sh</string>
        <string>--which</string>
        <string>all</string>
        <string>--final</string>
        <string>--send</string>
        <string>--text</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Once a day, AFTER the last hourly, never beside it. Hour/Minute are
         machine LOCAL time; Lucy 2 is Central.

         The shape every day follows: the gaps sweep ends, the hourly posts
         30 minutes later, and this final posts an hour after that. Weekdays
         gaps end 17:30, so hourly is 18:00 and this is 19:00. Saturday gaps
         end 15:30, so hourly is 16:00 and this is 17:00.

         SATURDAY WAS 16:00, the hourly's own minute (fixed 2026-11-20). All
         three b2b jobs run the same module and b2b_dispositions.sh skips
         itself when it sees that module already running, so every Saturday
         one of the two died on arrival and which one was a race. Nothing
         reported it: the loser logs one SKIPPED line and exits 0.
         Keep this an hour off the hourly. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-dispositions-final.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-dispositions-final.launchd.err.log</string>
</dict>
</plist>
