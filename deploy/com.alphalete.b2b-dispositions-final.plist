<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.b2b-dispositions-final</string>

    <!-- The 6:30pm final: the last Today's Activity + Time Tracker shots (tagged
         "Final") AND the per-territory Dispositions. Path is the laptop
         placeholder; install_agent.py rewrites it on Lucy 2:
         python -m automations.day_orchestrator.install_agent b2b-dispositions-final -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/b2b_dispositions.sh</string>
        <string>--which</string>
        <string>all</string>
        <string>--final</string>
        <string>--send</string>
        <string>--text</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Mon-Fri 7pm. SATURDAY IS 4pm AND MUST STAY 4pm: Carlos asked for it
         by name (8/6, commit b8b89e6): "Saturday can the last message on
         slack and text message be at 4pm." Hour/Minute are machine LOCAL
         time; Lucy 2 is Central.

         It was briefly moved to 17:00 on 2026-11-20 to dodge a clash with
         the Saturday hourly, which also fires 16:00. That was the wrong end
         of the clash: it made Carlos's last Saturday message land at 5pm.
         Reverted the same day. The hourly is the one out of place on
         Saturday (see the note in test_schedule_collisions.py), and moving
         it is a decision about his report, not a schedule tidy up.

         NOTE ON COMMENTS IN THIS FILE: never write two hyphens together
         inside an XML comment. It ends the comment early and makes the
         plist unreadable to plistlib even though plutil still accepts it,
         so the job keeps running while our own tooling goes blind to it. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-dispositions-final.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-dispositions-final.launchd.err.log</string>
</dict>
</plist>
