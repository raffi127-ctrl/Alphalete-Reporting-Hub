<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.b2b-dispositions-final</string>

    <!-- RETIRED 2026-09-29. NOTHING INSTALLS THIS AND NOTHING RUNS IT.
         Carlos moved everything to one post that day, which
         com.alphalete.b2b-dispositions-hourly now does (Mon to Fri 6pm,
         Sat 4pm). schedule_config.json has only remove_b2b_dispositions_final_agent
         for this label, no install entry; the file is kept so that removal
         still has something to unload.

         SO THE TIMES BELOW ARE HISTORY, NOT A SCHEDULE. Reading them as live
         cost two wrong changes on 2026-11-20: first this file's Saturday was
         moved off 4pm to dodge a clash that no machine has had since
         September, then the LIVE hourly was nearly moved for the same reason.
         Saturday's 4pm close now belongs to the hourly. Do not move either
         one; see test_schedule_collisions.py.

         WHAT IT USED TO DO: the 6:30pm final, the last Today's Activity +
         Time Tracker shots (tagged "Final") AND the per-territory
         Dispositions. Path is the laptop placeholder; install_agent.py
         rewrote it on Lucy 2:
         python -m automations.day_orchestrator.install_agent b2b-dispositions-final -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/b2b_dispositions.sh</string>
        <string>--which</string>
        <string>all</string>
        <string>--final</string>
        <string>--send</string>
        <string>--text</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- HISTORICAL. Mon to Fri 7pm, Saturday 4pm, as it ran until 2026-09-29.
         Saturday was 4pm because Carlos asked for it by name (8/6, commit
         b8b89e6): "Saturday can the last message on slack and text message
         be at 4pm." That requirement did not retire with this agent; it now
         lives on com.alphalete.b2b-dispositions-hourly, Weekday 6 at 16:00.
         Hour/Minute are machine LOCAL time; Lucy 2 is Central.

         NOTE ON COMMENTS IN THIS FILE: never write two hyphens together
         inside an XML comment. It ends the comment early and makes the
         plist unreadable to plistlib even though plutil still accepts it,
         so the job keeps running while our own tooling goes blind to it. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-dispositions-final.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-dispositions-final.launchd.err.log</string>
</dict>
</plist>
