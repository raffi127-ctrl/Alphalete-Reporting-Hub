<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.relay-archive</string>

    <!-- Path is the laptop placeholder; on Lucy 1, install_agent.py rewrites it
         to that machine's repo path (lucy rerun install_relay_archive_agent).
         NOT INSTALLED until Megan says "use the real Sheet" (2026-11-18). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/relay_archive_nightly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Every night, 2:00 AM (Lucy 1 runs on Central time). -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/relay-archive.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/relay-archive.launchd.err.log</string>
</dict>
</plist>
