<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.box-order-log-owners</string>

    <!-- Path is the laptop placeholder; on the mini, install_agent.py rewrites it
         to that machine's repo path (python -m automations.day_orchestrator.install_agent
         box-order-log-owners). RUNS ON THE MINI — its OwnerVille/Tableau session
         sees ALL BOX owners org-wide (Lucy 2 is scoped to Carlos). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/box_order_log_owners.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- DAILY incl. weekends. TWICE a day, 7:00 and 8:30 CST — same window as
         Carlos's box-order-log agent (BOX extract lands ~7-8am). EXACTLY ONE
         email per owner per day: box_order_log_owners.sh writes a dated marker
         after a successful send, so 8:30 skips an owner already emailed; if 7:00
         didn't send (data not fresh / failure), 8:30 sends. Never two.
         Hour/Minute are machine LOCAL time; the mini is Central. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/com.alphalete.box-order-log-owners.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.alphalete.box-order-log-owners.err</string>
</dict>
</plist>
