<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.tracker-auto-commit</string>

    <!-- Path is the laptop placeholder; the mini_control install action
         rewrites it for the machine. RUNS ON LUCY 1.

         Commits confirmed tracker enrollments (Tracker Onboarding tab, wired
         rows) to origin/main so the mini's 4am self-update can never reset a
         freshly confirmed office out of the daily tracker run. Two passes:
         03:15 = last chance before the 4am flow; 17:30 = same-evening
         durability for anything Megan confirmed during the day. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/tracker_auto_commit.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/tracker-auto-commit.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/tracker-auto-commit.launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
