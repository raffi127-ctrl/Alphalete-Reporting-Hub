<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.alphalete.lucy-transcriber</string>
    <!-- Always-on Lucy Transcriber bot (Socket Mode). KeepAlive restarts it if
         it dies. PATHS ARE MEGAN'S LAPTOP and are rewritten at install time
         (`lucy rerun install_lucy_transcriber_agent`). Tokens come from
         ~/.config/recruiting-report/transcriber-bot-token + transcriber-app-token. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/lucy_transcriber.sh</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/megan/1st Claude Folder</string>
    <key>EnvironmentVariables</key><dict><key>PYTHONPATH</key><string>/Users/megan/1st Claude Folder</string></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <!-- No hammer-restart when it can't start (e.g. tokens not placed yet). -->
    <key>ThrottleInterval</key><integer>60</integer>
    <key>StandardOutPath</key><string>/tmp/com.alphalete.lucy-transcriber.out</string>
    <key>StandardErrorPath</key><string>/tmp/com.alphalete.lucy-transcriber.err</string>
</dict>
</plist>
