<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.je-opt-monday-catchup</string>

    <!-- Path is the laptop placeholder; on the mini, regenerate with the install
         path via the python-replace step in workflows/scheduler-mini.md. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/je_opt_monday_catchup.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Monday 3:00pm, machine LOCAL time (the mini is Central). launchd
         Weekday: 0/7=Sun, 1=Mon … 6=Sat. Runs AFTER Just Energy publishes the
         just-closed Sunday (observed ~1:53pm) and AFTER board_catchup's 14:30,
         and BEFORE Tuesday, when the Org Sales Board's reporting week rolls
         (org_sales_board/week.py reporting_monday) — run it past that roll and
         it writes into a day of the new week that does not correspond.
         TIME KNOB: change Hour to 16 for 4pm CST. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>15</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/je-opt-monday-catchup.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/je-opt-monday-catchup.launchd.err.log</string>
</dict>
</plist>
