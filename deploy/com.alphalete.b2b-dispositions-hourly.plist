<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.b2b-dispositions-hourly</string>

    <!-- ONCE A DAY since 2026-09-29 (Carlos): Box Today's Activity + 15-min
         gaps into "Hourly Activity", plus Box Territory Stats (one picture per
         territory) into "Territory Stats", plus the 6pm Box 15-min gaps card
         (Slack + Box B2B text; --text). The -final agent is retired. The 12/2/4
         gaps runs are com.alphalete.b2b-dispositions-gaps. Path is the laptop placeholder; on Lucy 2,
         install_agent.py rewrites it to the mini's repo path:
         python -m automations.day_orchestrator.install_agent b2b-dispositions-hourly -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/b2b_dispositions.sh</string>
        <string>--which</string>
        <string>all</string>
        <string>--send</string>
        <string>--text</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Mon-Fri 6pm, Sat 4pm (Carlos 9/27: no disposition posts after 5:30 on
         Saturdays), Sunday never. Machine LOCAL time; Lucy 2 is Central. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-dispositions-hourly.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/b2b-dispositions-hourly.launchd.err.log</string>
</dict>
</plist>
