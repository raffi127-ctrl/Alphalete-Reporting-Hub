<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.org-board-slack</string>

    <!-- Path is the laptop placeholder; on the mini, install_agent.py rewrites it
         to the mini's repo path (python -m automations.day_orchestrator.install_agent
         org-board-slack). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/org_board_slack.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- DAILY incl. weekends (no Weekday key). First pass 8:30 CST (Megan
         2026-07-18; the VA posted ~8:05-8:17), then q25m retries as a safety net.
         The module's LIGHT gate posts unless yesterday is entirely empty, and a
         once-per-day state file no-ops the remaining passes. TIME KNOB: edit
         these entries (Hour/Minute are machine LOCAL time; the mini is Central). -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- THREE EARLY SLOTS PREPENDED, first one 07:15 (Eve 2026-08-11); the
             original 08:30..11:25 grid below is untouched.

             WHY 07:15 AND NOT EARLIER. The board's last-landing source is the
             BOX daily tracker, whose Tableau extract refreshes ~7-8am; the
             board's readiness gate (tableau:box_daily) opened 06:50-07:06 every
             day over 8/04-8/11, and the fill itself takes 9-14 min, so the fill
             ENDED 07:04-07:11. A slot at 07:10 would sometimes fire while the
             fill was still running: slack_post.fill_gate would hold it and the
             board would slip to the NEXT slot, arriving later than before.
             07:15 clears the fill's observed tail with margin.

             Earlier than the fill is not a "slightly early" board — it is one
             with a stale or empty BOX section. -->
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>55</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>25</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/org-board-slack.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/org-board-slack.launchd.err.log</string>
</dict>
</plist>
