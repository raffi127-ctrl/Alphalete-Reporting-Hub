<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.org-board-slack</string>

    <!-- Path is the laptop placeholder; on the mini, install_agent.py rewrites it
         to the mini's repo path (python -m automations.day_orchestrator.install_agent
         org-board-slack). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/org_board_slack.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- DAILY incl. weekends (no Weekday key). First pass 8:30 CST (Megan
         2026-07-18; the VA posted ~8:05-8:17), then q25m retries as a safety net.
         The module's LIGHT gate posts unless yesterday is entirely empty, and a
         once-per-day state file no-ops the remaining passes. TIME KNOB: edit
         these entries (Hour/Minute are machine LOCAL time; the mini is Central). -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- FIRST SLOT 08:30 -> 07:10 (Eve 2026-08-11). 07:10 and not earlier
             because the board's last-landing source is the BOX daily tracker,
             whose Tableau extract refreshes ~7-8am: measured over 8/04-8/11 the
             board's readiness gate (tableau:box_daily) opened 06:50-07:06 every
             day, so 07:10 is the first minute a COMPLETE board exists. Earlier
             would only publish a board with a stale/empty BOX section.
             The 25-min cadence and the ~11:25 tail are unchanged — later slots
             are cheap no-ops once the day's post has landed. -->
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>35</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>40</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>55</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>20</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/org-board-slack.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/org-board-slack.launchd.err.log</string>
</dict>
</plist>
