<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.enrollment-pending-hourly</string>

    <!-- Path is the laptop placeholder; on Lucy 1 install_agent.py rewrites it:
           python -m automations.day_orchestrator.install_agent enrollment-pending-hourly
         RUNS ON LUCY 1.

         Megan 2026-08-19: moved OFF the 4am orchestrator pass. This is a safety
         net, not a report - it speaks only when an office enrollment is sitting
         un-applied. At 4am only, an enrollment added at 9:05am waited a full day
         to be noticed. Hourly through the working day closes that gap.

         Set on_scheduler:false in schedule_config at the same time, so the 4am
         batch does not also run it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/enrollment_pending_hourly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Every hour on the hour, 09:00 through 22:00 LOCAL (mini is CST), all 7
         days. Nothing overnight: an enrollment landing at 2am is caught by the
         9am pass, and nobody is watching the channel before then.
         NOTE: launchd caches the schedule from BOOT time and ignores a rewritten
         plist on a plain reload; after changing these hours, bootout + bootstrap
         (install_agent does it correctly). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/enrollment-pending.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/enrollment-pending.launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
