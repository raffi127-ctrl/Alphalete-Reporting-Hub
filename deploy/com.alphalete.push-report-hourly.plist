<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.push-report-hourly</string>

    <!-- TWICE-DAILY (Carlos 2026-09-27: "switch it to twice a day... once at 1 pm
         and then one at 8 pm") resume-push report to the group chat. Was hourly
         (2026-09-24: "every hour report
         back to me"). RUNS ON LUCY 2. install_agent.py rewrites the laptop
         placeholder path:
           python -m automations.day_orchestrator.install_agent push-report-hourly
         :15 past the hour, 8am-10pm, every day — a beat after the push ticks so
         the diag tabs already carry the hour's runs. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/push_report_hourly.sh</string>
        <!-- post in the Carlos/Eve/Lucy/Megan group chat -->
        <string>--group</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/push-report-hourly.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/push-report-hourly.log</string>
</dict>
</plist>
