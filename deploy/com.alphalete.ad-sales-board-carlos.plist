    <!-- Ad Sales Board, Carlos fast lane: office 11580 only, every 30 minutes
         (Carlos 2026-10-20: "mine update every 30 mins"). Path is the laptop
         placeholder; install_agent.py rewrites it to the installing machine's
         repo path:
         lucy rerun install_ad_sales_board_carlos_agent  (machine: Lucy 2) -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/ad_sales_board_carlos.sh</string>
    </array>

    <key>WorkingDirectory</key>
