<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.terminated-reps-evening</string>

    <!-- Path is the laptop placeholder; on the mini, install_agent.py rewrites it:
           python -m automations.day_orchestrator.install_agent terminated-reps-evening
         RUNS ON THE MAC MINI so the post goes out as Lucy — from any other box
         it posts under whoever's Slack token is on that machine. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/terminated_reps_evening.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- 8:00pm CST, EVERY day (no Weekday key = daily) — the module's cadence is
         all 7 days and terminations get marked on weekends too. Same-day pass:
         the board is marked during the day, and the 4am orchestrator's own run
         lands mid-morning and quits at the noon backstop, so without this the
         notice always arrived a day late.
         TIME KNOB: edit Hour/Minute below (machine LOCAL time; the mini is
         Central). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/com.alphalete.terminated-reps-evening.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.alphalete.terminated-reps-evening.err</string>
</dict>
</plist>
