<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alphalete.wifi-selfheal</string>
  <!-- Every 2 min: is the internet there? After ~6 min without it, turn Wi-Fi
       off and on (what Megan did by hand at Lucy 1 on 2026-10-20 after it sat
       "connected, no internet" for 2+ hours). User-level, NO root. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/megan/1st Claude Folder/deploy/wifi_selfheal.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>120</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/megan/1st Claude Folder/output/logs/wifi-selfheal.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/megan/1st Claude Folder/output/logs/wifi-selfheal.err.log</string>
</dict>
</plist>
