<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.digi-docs-add</string>

    <!-- Install on LUCY 3 with:
             lucy rerun install_digi_docs_add_agent (add machine "Lucy 3")
         This pass adds people to OwnerVille and mails nobody.

         NOTE ON COMMENTS IN THIS FILE: never write two hyphens together
         inside an XML comment. It ends the comment early and makes the plist
         unparseable to plistlib even though plutil still accepts it, which
         shows up as a Hub card that cries wolf forever. The sibling
         blueink-docs-monday.plist has exactly that defect today. -->

    <!-- Path is the laptop placeholder; on Lucy 3, install_agent.py rewrites
         it to that machine's repo path. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/digi_docs.sh</string>
        <string>--add</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- 8:00am EVERY DAY, machine LOCAL time (Lucy 3 is Central). No Weekday
         key on purpose: this report fires on the date written above a chart,
         and those dates being Mondays is a coincidence of how the sheet gets
         filled in, not the rule (Megan 2026-08-26). A chart dated for a
         Wednesday has to be added on that Wednesday.

         Firing daily is cheap because the run stops on the sheet read when no
         chart is dated for today, long before it opens a browser. THE ADD PASS
         MAILS NOBODY; the sends are the separate com.alphalete.digi-docs-send
         job, 30 minutes before each person's own start time. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/digi-docs-add.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/digi-docs-add.launchd.err.log</string>
</dict>
</plist>
