<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.ad-sales-board</string>

    <!-- Ad Sales Board: the Source Report week by week (pull + names).
         Path is the laptop placeholder; install_agent.py rewrites it to the
         installing machine's repo path:
         python -m automations.day_orchestrator.install_agent ad-sales-board -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/ad_sales_board.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- 7:50am daily, machine-local (Lucy 2 is Central). Deliberately AFTER
         applicant_tracker's 6:45 morning import (yesterday's call-list names)
         and clear of the 4am AppStream cluster. TIME KNOB lives here. -->
    <!-- ONCE DAILY at 07:50 (Carlos 2026-10-20: "lets have the 17 org offices
         update only once a day and mine update every 30 mins").

         07:50 stays the anchor because it lands AFTER applicant_tracker's
         06:45 Call List import puts yesterday's names in; an earlier pass
         would refresh the week without them. The SCI captainship pass rides
         this same daily run (second pass in deploy/ad_sales_board.sh), so
         captainship also refreshes once a day.

         Carlos's own office (11580) refreshes every 30 minutes through the
         separate com.alphalete.ad-sales-board-carlos agent
         (deploy/ad_sales_board_carlos.sh) — single office, --today partial
         day pull, no SCI pass. Its pgrep guard makes it step aside while
         this full pass runs.

         History: every two hours 07:50-21:50 from 2026-08-27 to 2026-10-20.

         TIME KNOB: edit this array, then re-install:
           lucy rerun install_ad_sales_board_agent  (machine: Lucy 2)     -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>50</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/com.alphalete.ad-sales-board.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.alphalete.ad-sales-board.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
