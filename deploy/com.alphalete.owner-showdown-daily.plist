<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.owner-showdown-daily</string>

    <!-- Path is the laptop placeholder; on the mini, install_agent.py rewrites it
         to that machine's repo path (python -m automations.day_orchestrator.install_agent
         owner-showdown-daily). RUNS ON THE MINI — its OwnerVille/Tableau session
         is the one that can export the two Showdown crosstabs. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/owner_showdown_daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- DAILY incl. weekends, 9:00am CST (Megan 2026-08-03) — late enough that
         the prior day's sales have landed in Tableau, unlike the 4am batch.
         Hour/Minute are machine LOCAL time; the mini is Central. The nightly
         orchestrator-schedule-guard reloads this if launchd's cached TZ drifts
         the fire time. TEMP: remove after 8/31 with the rest of the card. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/com.alphalete.owner-showdown-daily.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.alphalete.owner-showdown-daily.err</string>
</dict>
</plist>
