<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.alphalete.knocks-9pm</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>/Users/megan/1st Claude Folder/deploy/knocks_9pm.sh</string><string>--send</string></array>
    <key>WorkingDirectory</key><string>/Users/megan/1st Claude Folder</string>
    <key>EnvironmentVariables</key><dict><key>PYTHONPATH</key><string>/Users/megan/1st Claude Folder</string></dict>
    <!-- 21:00 CENTRAL, one clock for every office (Raf 2026-08-25: "9:00PM
         CEN"). The box this runs on must BE on Central, or this fires at the
         wrong hour: launchd reads the calendar in the machine's local zone,
         and it caches the zone at load — the +2h drift that has bitten this
         fleet before. VERIFY WITH A REAL FIRE, not by reading this file.
         See [[project_mini_launchd_drift]]. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key><string>/tmp/com.alphalete.knocks-9pm.out</string>
    <key>StandardErrorPath</key><string>/tmp/com.alphalete.knocks-9pm.err</string>
    <key>RunAtLoad</key><false/>
</dict>
</plist>
