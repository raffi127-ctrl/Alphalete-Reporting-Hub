<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.funnel-board-hourly</string>

    <!-- Path is the laptop placeholder; on Lucy 1, install_agent.py rewrites it:
           python -m automations.day_orchestrator.install_agent funnel-board-hourly
         RUNS ON LUCY 1 (holds the ApplicantStream login that reaches all 17
         offices; Lucy 2's login is missing five of them).

         The 4am orchestrator pass still owns the daily run and the Monday
         close-out of the prior week. This agent is the intraday cadence Carlos
         asked for on 2026-08-11 so Manager Board / Manager Trend aren't showing
         five-hour-old numbers. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/funnel_board_hourly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Hourly at :05, 6am-9pm LOCAL (the minis are Central), every day.
         WHY NOT 24x7: a pass costs ~8-10 min of real browser against
         ApplicantStream x17 offices, and between 10pm and 5am there is nothing
         to collect - nobody is booking interviews, so a pull would rewrite the
         week with identical numbers. The 4am orchestrator pass already covers
         the overnight boundary and the Monday close-out.
         TIME KNOB: add/remove Hour dicts below to widen or narrow the window;
         adding 22,23,0,1,2,3,4,5 makes it literally 24x7. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>5</integer></dict>
    </array>

    <!-- A missed window (mini asleep/off) should NOT stampede every skipped hour
         at once when it wakes. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/funnel-board-hourly.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/funnel-board-hourly.err</string>
</dict>
</plist>
