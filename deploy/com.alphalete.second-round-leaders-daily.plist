    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/second_round_report.sh</string>
        <string>--view</string>
        <string>leaders</string>
        <string>--weeks</string>
        <string>4</string>
        <string>--through</string>
        <string>yesterday</string>
        <string>--pull</string>
        <string>--text</string>
