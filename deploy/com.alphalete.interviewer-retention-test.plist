    <key>StandardOutPath</key><string>/tmp/com.alphalete.interviewer-retention-test.out</string>
    <key>StandardErrorPath</key><string>/tmp/com.alphalete.interviewer-retention-test.err</string>
    <key>RunAtLoad</key><false/>
