    <key>Label</key>
    <string>com.alphalete.nds-oof</string>

    <!-- BOX-3, Box 15-min gaps card (Carlos 2026-09-29): Slack thread "Box
         15 Min Gaps" + the Box B2B text, every 30 min from 12. The 6pm run (Sat
         4pm) rides the -hourly agent's `all`, so the two never fire at once.
         Path is the laptop placeholder; install_agent.py rewrites it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/nds_oof.sh</string>
        <string>--send</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

