<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.gap-alerts</string>

    <!-- Path is the laptop's; on Lucy 1, regenerate with the install path.
         /bin/bash on a wrapper is deliberate: that is the executable identity
         macOS granted "control Messages" to on Lucy 1 (the day-orchestrator
         plist has the same shape, and owner_chat_texts sends images through
         it). A plist that ran .venv/bin/python directly would be a NEW
         identity and would block on an unattended consent dialog. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/gap_alerts_5min.sh</string>
        <string>--send</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Ticks every MINUTE; the wrapper decides which minutes count and exits in
         milliseconds on the rest (wrong day, wrong hour, or a minute that is not
         a multiple of 5). It has to be this way round: StartInterval counts from
         when the previous run EXITS, so a 300 here meant "5 minutes after the
         last run finished" and a slow browser launch stretched the gap to nearly
         9 minutes. At 60 the wrapper's own clock check is what sets the cadence.

         Still StartInterval and not StartCalendarInterval: ~100 calendar entries
         would be unreadable, and launchd caches its timezone on these boxes and
         has fired calendar jobs two hours off. The wrapper reads the real local
         clock every run, so a cached TZ cannot move it. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/gap-alerts.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/gap-alerts.launchd.err.log</string>
</dict>
</plist>
