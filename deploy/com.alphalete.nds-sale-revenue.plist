    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/nds-sale-revenue.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/nds-sale-revenue.launchd.err.log</string>
</dict>
</plist>
