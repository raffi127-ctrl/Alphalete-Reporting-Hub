    <!-- 1st to 2nd Below the Mark: each office at its OWN 11:00 AM and 6:30 PM,
         Monday to Saturday (Rafael, 2026-09-21). The agent fires at every CT
         time some zone reaches one of those; the board picks the offices due
         from the clock (office_tz.py), so daylight saving and Arizona need no
         change here:
             ET 10:00 / 17:30   CT 11:00 / 18:30   MT 12:00 / 19:30   PT 13:00 / 20:30
         Path is the laptop placeholder; install_agent.py rewrites it:
         python -m automations.day_orchestrator.install_agent below-the-mark -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/below_the_mark.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

