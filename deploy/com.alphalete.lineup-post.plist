<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.lineup-post</string>
    <!-- Line Up picture + Car Ride names (Raf, Loom 2026-10-22).
         LUCY 1. Path is the laptop placeholder; install_agent.py rewrites it.
         One agent, both slots: run.py's --auto sends the picture before 4pm CT
         and the names after. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/lineup_post.sh</string>
        <string>--auto</string>
        <string>--send</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>
