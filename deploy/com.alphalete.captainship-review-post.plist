<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.captainship-review-post</string>

    <!-- Path is the laptop placeholder; on the mini, install_agent.py rewrites it
         to the mini's repo path (lucy rerun install_captainship_review_post_agent). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/captainship_review_post.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- EVERY DAY (launchd Weekday: 0/7=Sun, 1=Mon, 2=Tue…), machine LOCAL time —
         the mini is Central. Seven days because captainship_drafts is seven days
         (since 2026-08-10); nothing about these reports waits for the afternoon.

         07:15 is the real slot. Eve's ask (2026-08-19): the Captainship link
         right behind the Org Sales Board's so "se envien practicamente juntos
         (aprox 7:15/20am central)". The board's own review link is at 07:00
         (com.alphalete.org-board-review-post), so the approvers get both inside
         a quarter of an hour, and com.alphalete.captainship-review — every 15
         min from 07:00 — turns a checkmark at ~07:20 into twelve sent reports by
         ~07:35.

         07:45 / 08:15 / 09:15 are a safety net for a morning where the 4am chain
         had not finished building the previews at 07:15. They cannot double-post:
         the wrapper runs review_gate with the ensure-posted flag, a no-op once the
         day is up for review (approved or not), and BUILDS the previews itself if
         the chain never produced them. Past 09:15 deploy/captainship_review.sh
         keeps calling ensure-posted every 15 min from its 10:00 deadline, so a
         day still cannot end unasked. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>

        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>45</integer></dict>
