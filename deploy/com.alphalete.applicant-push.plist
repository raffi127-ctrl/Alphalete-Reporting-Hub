<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.applicant-push</string>

    <!-- Path is the laptop placeholder; on Lucy 2, install_agent.py rewrites it
         to that machine's repo path (lucy rerun install_applicant_push_agent). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/applicant_push.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Fire every 2 min around the clock (:00/:02/…/:58). Was every 5 until
         2026-09-21, when Megan asked for the queues to be processed "asap and as
         quick as possible": walks had got short (1-6 min once the backlog cleared
         and the walk learned to stop itself), so a 5-min clock left each box idle
         between ticks and each office waited ~15 min for its turn with three
         offices per box. Every 2 min, a box starts its next office almost as soon
         as the last one finishes — ~6 min per office. Nothing here makes a walk
         riskier: launchd keeps ONE instance per label, so a walk longer than 2 min
         simply holds the slot and the missed ticks are skipped, never stacked.
         The wrapper (applicant_push.sh) gates the ACTIVE window to 7am-10pm, EVERY
         day; outside it every tick exits immediately. Machine LOCAL time.
         TIME KNOB for hours: edit the window gate in the wrapper, NOT this array. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>2</integer></dict>
        <dict><key>Minute</key><integer>4</integer></dict>
        <dict><key>Minute</key><integer>6</integer></dict>
