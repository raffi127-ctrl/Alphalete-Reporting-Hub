<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.lucy2-digest</string>

    <!-- Runs on LUCY 1 (the always-on mini). Intraday BOTH-MACHINE error watcher:
         reads the shared Hub Activity log and posts deduped, real-time corrections
         alerts for standalone reports that errored on EITHER machine. Path is the
         laptop's; on the mini, (re)install via `lucy rerun install_lucy2_digest_agent`. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/lucy2_digest_daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- Every 30 min. The wrapper self-gates to 04–21 CST so off-hours firings are
         a no-op (no wasted Sheet reads overnight). -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/lucy2-digest.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/lucy2-digest.launchd.err.log</string>
</dict>
</plist>
