<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.vantura-revenue-board</string>

    <!-- Path is the laptop placeholder; install_agent.py rewrites it to the
         installing machine's repo path. Runs on LUCY 2 — the Vantura board is
         Carlos's and the order-log tabs are refreshed by his 4am batch. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/vantura_revenue_board.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- DAILY incl. weekends. 05:20 / 05:50 / 06:30: AFTER sales-boards'
         05:10 post creates the thread — the AT&T board lands here. 07:25 /
         08:50 / 09:40: the BOX board, once box_order_log's 7:00/8:30 csv
         carries the day (its extract refreshes ~7am). The module holds
         (exit 75) while a board's data or the thread is missing, and dedups
         per board plain so each reply lands exactly once. Hour/Minute are
         machine LOCAL time; Lucy 2 is Central. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>25</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>50</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>40</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/vantura-revenue-board.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/vantura-revenue-board.launchd.err.log</string>
</dict>
</plist>
