<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphalete.harvest-3am</string>

    <!-- Path is the laptop's; on the mini, regenerate with the install path via
         the python-replace step in workflows/scheduler-mini.md. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/megan/1st Claude Folder/deploy/harvest_3am.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/megan/1st Claude Folder</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/megan/1st Claude Folder</string>
    </dict>

    <!-- 2:30am every day, LOCAL time (mini is CST). NOT 3:00: that slot already
         has due-diligence-harvest (Jiraiya's cache) AND appstream-morning, and
         ownerville allows ONE session per account — three jobs at 3:00 would
         fight over the same login. 2:30 clears them and still finishes before
         the 4:00 orchestrator.
         NOTE: launchd caches the schedule from BOOT time and ignores a rewritten
         plist on a plain reload; after changing this Hour, bootout + bootstrap
         (automations.day_orchestrator.install_agent does it correctly). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/harvest-3am.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/megan/1st Claude Folder/output/logs/harvest-3am.launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
