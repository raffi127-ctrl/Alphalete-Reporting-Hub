{
  "manifest_version": 3,
  "name": "Lucy Optix",
  "version": "1.0.1",
  "description": "Sends your office's Optix knocks and sales (counts only) to Lucy every 10 minutes, from the Lead Details tab you already have open.",
  "permissions": ["storage", "scripting", "alarms", "tabs"],
  "host_permissions": [
    "https://optixtogo.verizon.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lucy Optix",
    "default_icon": {"16": "icons/lucy-16.png", "32": "icons/lucy-32.png", "48": "icons/lucy-48.png", "128": "icons/lucy-128.png"}
  },
  "icons": {"16": "icons/lucy-16.png", "32": "icons/lucy-32.png", "48": "icons/lucy-48.png", "128": "icons/lucy-128.png"}
}
